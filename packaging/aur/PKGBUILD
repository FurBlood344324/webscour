# Draft (2026-11-20), staged not submitted: AUR registration is closed for now.
# pkgver starts as the planned first Rust release (0.2.0, after 0.1.3 python);
# sha256sums are SKIP until the release tag exists, then updpkgsums fills them.
# Submission procedure is in packaging/aur/README.md. No CI: hands only.

pkgname=webscour
pkgver=0.2.0
pkgrel=1
pkgdesc='Keyless web search CLI for agents: local SearXNG first, scraper fallbacks, structured sources'
arch=('x86_64' 'aarch64')
url='https://github.com/FurBlood344324/webscour'
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')
source=("$pkgname-$pkgver.crate::https://crates.io/api/v1/crates/$pkgname/$pkgver/download")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/wsc" "$pkgdir/usr/bin/wsc"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
